<!doctype html>
<html lang="pt" data-tema="oscuro">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PreceptorOS · O teu companheiro soberano</title>
<meta name="description" content="PreceptorOS · Tu compañero de IA soberano. Instálalo en tu máquina, sin nube, sin telemetría. Servido desde un rack 99% solar. Tu memoria, tu identidad, tu privacidad.">
<link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
<meta property="og:title" content="PreceptorOS · Tu IA, tu memoria, tu soberanía">
<meta property="og:description" content="Tu guía de IA en casa: se instala y ya te acompaña. Memoria persistente en tu máquina, contexto saneado antes de salir. Sin cuentas, sin telemetría, sin nube obligatoria.">
<meta property="og:image" content="https://preceptoros.org/assets/preceptor-og.png">
<meta property="og:url" content="https://preceptoros.org/es/">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
