{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "preceptoros:caravana/1",
 "title": "Caravana de comercio entre nodos (borrador E2)",
 "description": "Solo recursos del motor, enteros; caduca por ciclo de juego, nunca por reloj; un borrador de agente no se liquida sin firma humana (EMULATED). Sin dinero real, sin cripto. Vive fuera de `public/`: es el contrato, no se sirve. Lo valida `atlas/puros/caravan.js`.",
 "type": "object",
 "additionalProperties": false,
 "required": ["route", "state", "cargo", "cycle_proposed", "cycle_expires", "signature"],
 "properties": {
  "route": {
   "type": "object",
   "additionalProperties": false,
   "required": ["from_place", "to_place"],
   "properties": {
    "from_place": { "$ref": "#/$defs/lugar" },
    "to_place": { "$ref": "#/$defs/lugar" }
   }
  },
  "state": {
   "enum": ["PROPOSED", "ACTIVE", "INTERCEPTED", "COMPLETED", "FLED", "EXPIRED", "EMULATED", "NO_DATA"]
  },
  "cargo": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["resource", "amount"],
    "properties": {
     "resource": { "enum": ["luz", "biomasa", "cobre", "flujo", "oxigeno"] },
     "amount": { "type": "integer", "minimum": 1, "maximum": 1000000 }
    }
   }
  },
  "cycle_proposed": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
  "cycle_expires": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
  "signature": {
   "type": "object",
   "additionalProperties": false,
   "required": ["state"],
   "properties": {
    "state": { "enum": ["REQUIRED", "SIGNED"] }
   }
  }
 },
 "$defs": {
  "lugar": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" }
 }
}
