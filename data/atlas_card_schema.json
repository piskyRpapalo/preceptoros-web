{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preceptoros.ficha/1",
  "title": "Ficha de lenguaje VT1-VT6 (matematica sin piel)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "pieza", "mundo", "id", "mesura", "vara", "sello", "causa", "texto", "sonido_hz"],
  "properties": {
    "v": {"const": "preceptoros.ficha/1"},
    "pieza": {"enum": ["VT1", "VT2", "VT3", "VT4", "VT5", "VT6"]},
    "mundo": {"type": "string", "pattern": "^[a-z0-9-]{1,32}$"},
    "id": {"enum": ["C24", "A4", "A7", "A6", "C23", "C28"]},
    "mesura": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glyph", "trazo", "movimiento", "onda_hz"],
      "properties": {
        "glyph": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0, "maximum": 3}},
        "trazo": {"type": "string"},
        "movimiento": {"type": "string"},
        "onda_hz": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "vara": {"type": "string", "minLength": 1},
    "sello": {"enum": ["MEDIDO", "LIVE", "EMULADO", "SIMULATED", "STALE", "NO_DATA"]},
    "causa": {"type": ["string", "null"]},
    "texto": {"type": "string", "minLength": 1},
    "sonido_hz": {"type": "number", "exclusiveMinimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"sello": {"const": "NO_DATA"}}, "required": ["sello"]},
      "then": {"properties": {"causa": {"type": "string", "minLength": 1}}, "required": ["causa"]},
      "else": {"properties": {"causa": {"type": "null"}}}
    }
  ]
}
