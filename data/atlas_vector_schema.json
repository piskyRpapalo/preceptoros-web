      ]
    },
    "e": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [{"type": "string", "minLength": 1}, {"type": "string", "minLength": 1}, {"$ref": "#/$defs/vida"}], "items": false}},
