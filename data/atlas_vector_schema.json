    "n": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"type": "string", "minLength": 1}, {"type": "string", "pattern": "^[0-9]+/[0-9]+$"}], "items": false}},
