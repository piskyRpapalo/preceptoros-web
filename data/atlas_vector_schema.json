      ]
    },
    "p": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "minItems": 3, "maxItems": 3,
         "prefixItems": [{"$ref": "#/$defs/noVacio"}, {"$ref": "#/$defs/noVacio"}, {"$ref": "#/$defs/ciclo"}], "items": false}
      ]
    },
    "t": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "minItems": 2, "maxItems": 2,
