    "q": {"type": "array", "maxItems": 3, "items": {"type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [{"type": "string", "minLength": 1}, {"type": "string", "minLength": 1}, {"$ref": "#/$defs/ciclo"}], "items": false}},
