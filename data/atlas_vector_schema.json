      ]
    },
    "nd": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "c": {"$ref": "#/$defs/causa"}, "r": {"$ref": "#/$defs/causa"}, "k": {"$ref": "#/$defs/causa"},
        "p": {"$ref": "#/$defs/causa"}, "t": {"$ref": "#/$defs/causa"}, "e": {"$ref": "#/$defs/causa"},
        "l": {"$ref": "#/$defs/causa"}, "n": {"$ref": "#/$defs/causa"}, "z": {"$ref": "#/$defs/causa"},
        "q": {"$ref": "#/$defs/causa"}, "g": {"$ref": "#/$defs/causa"}, "recorte": {"$ref": "#/$defs/causa"}
      }
    }
  },
  "$defs": {
    "numero": {"type": ["number", "null"]},
    "vida": {"type": ["number", "null"], "minimum": 0},
    "entero": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
    "ciclo": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000000},
    "noNegativo": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "texto": {"type": ["string", "null"]},
    "noVacio": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "causa": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"c": {"type": "null"}}, "required": ["c"]}, "then": {"properties": {"nd": {"required": ["c"]}}}},
    {"if": {"properties": {"r": {"type": "null"}}, "required": ["r"]}, "then": {"properties": {"nd": {"required": ["r"]}}}},
    {"if": {"properties": {"r": {"type": "array", "contains": {"type": "null"}}}, "required": ["r"]}, "then": {"properties": {"nd": {"required": ["r"]}}}},
    {"if": {"properties": {"k": {"type": "null"}}, "required": ["k"]}, "then": {"properties": {"nd": {"required": ["k"]}}}},
    {"if": {"properties": {"k": {"type": "array", "contains": {"type": "null"}}}, "required": ["k"]}, "then": {"properties": {"nd": {"required": ["k"]}}}},
    {"if": {"properties": {"p": {"type": "array", "contains": {"type": "null"}}}, "required": ["p"]}, "then": {"properties": {"nd": {"required": ["p"]}}}},
    {"if": {"properties": {"q": {"contains": {"type": "array", "minItems": 3, "prefixItems": [{}, {}, {"type": "null"}]}}}, "required": ["q"]}, "then": {"properties": {"nd": {"required": ["q"]}}}},
    {"if": {"properties": {"e": {"contains": {"type": "array", "minItems": 3, "prefixItems": [{}, {"const": "NO_DATA"}]}}}, "required": ["e"]}, "then": {"properties": {"nd": {"required": ["e"]}}}},
    {"if": {"properties": {"e": {"contains": {"type": "array", "minItems": 3, "prefixItems": [{}, {}, {"type": "null"}]}}}, "required": ["e"]}, "then": {"properties": {"nd": {"required": ["e"]}}}},
    {"if": {"properties": {"e": {"maxItems": 0}}, "required": ["e"]}, "then": {"properties": {"nd": {"required": ["e"]}}}},
    {"if": {"properties": {"l": {"maxItems": 0}}, "required": ["l"]}, "then": {"properties": {"nd": {"required": ["l"]}}}},
    {"if": {"properties": {"z": {"type": "null"}}, "required": ["z"]}, "then": {"properties": {"nd": {"required": ["z"]}}}}
  ]
}
