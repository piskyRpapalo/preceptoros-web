{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "preceptoros.vector/1",
  "title": "PreceptorOS game state vector v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "c", "r", "k", "p", "t", "e", "l", "n", "z", "q", "g", "nd"],
  "properties": {
    "v": {"const": "preceptoros.vector/1"},
    "c": {"$ref": "#/$defs/ciclo"},
    "r": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "minItems": 4, "maxItems": 4,
         "prefixItems": [{"$ref": "#/$defs/numero"}, {"$ref": "#/$defs/numero"}, {"$ref": "#/$defs/numero"}, {"$ref": "#/$defs/numero"}], "items": false}
      ]
