{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "preceptoros:atlas.contraoferta/1",
 "title": "Contraoferta",
 "description": "Responde a una oferta por su huella; mismas reglas que la oferta. Vive fuera de `public/`: es el contrato, no se sirve. Lo valida en JS `public/game/mercado.js` con la misma forma.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "esquema",
  "oferta",
  "da",
  "pide",
  "expira_ciclo",
  "nonce",
  "procedencia"
 ],
 "properties": {
  "esquema": {
   "const": "atlas.contraoferta/1"
  },
  "oferta": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "da": {
   "type": "object",
   "additionalProperties": false,
   "minProperties": 1,
   "properties": {
    "luz": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "biomasa": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "cobre": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "flujo": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "oxigeno": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    }
   }
  },
  "pide": {
   "type": "object",
   "additionalProperties": false,
   "minProperties": 1,
   "properties": {
    "luz": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "biomasa": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "cobre": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "flujo": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "oxigeno": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    }
   }
  },
  "expira_ciclo": {
   "type": "integer",
   "minimum": 0,
   "maximum": 1000000000
  },
  "nonce": {
   "type": "string",
   "pattern": "^[0-9a-f]{32}$"
  },
  "procedencia": {
   "enum": [
    "humano",
    "agente_borrador"
   ]
  }
 }
}
