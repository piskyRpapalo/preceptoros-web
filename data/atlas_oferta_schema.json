{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "preceptoros:atlas.oferta/1",
 "title": "Oferta entre personas (A2A preparado)",
 "description": "Solo recursos del motor, enteros; caduca por ciclo de juego, nunca por reloj; un borrador de agente no se liquida sin firma humana. Sin dinero real, sin cripto, sin moneda nueva. Vive fuera de `public/`: es el contrato, no se sirve. Lo valida en JS `public/game/mercado.js` con la misma forma.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "esquema",
  "da",
  "pide",
  "expira_ciclo",
  "nonce",
  "para",
  "procedencia"
 ],
 "properties": {
  "esquema": {
   "const": "atlas.oferta/1"
  },
  "da": {
   "type": "object",
   "additionalProperties": false,
   "minProperties": 1,
   "properties": {
    "luz": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "biomasa": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "cobre": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "flujo": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "oxigeno": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    }
   }
  },
  "pide": {
   "type": "object",
   "additionalProperties": false,
   "minProperties": 1,
   "properties": {
    "luz": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "biomasa": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "cobre": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "flujo": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "oxigeno": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    }
   }
  },
  "expira_ciclo": {
   "type": "integer",
   "minimum": 0,
   "maximum": 1000000000
  },
  "nonce": {
   "type": "string",
   "pattern": "^[0-9a-f]{32}$"
  },
  "procedencia": {
   "enum": [
    "humano",
    "agente_borrador"
   ]
  },
  "para": {
   "anyOf": [
    {
     "const": "cualquiera"
    },
    {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   ]
  }
 }
}
