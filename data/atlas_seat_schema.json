{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "preceptoros:atlas.asiento/1",
 "title": "Asiento del libro de mercado",
 "description": "La obligacion firmada por las dos partes, encadenada por hash. NO mueve recursos: el motor no tiene accion de transferencia y anadirla pide firma. Vive fuera de `public/`: es el contrato, no se sirve. Lo valida en JS `public/game/mercado.js` con la misma forma.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "esquema",
  "n",
  "prev",
  "oferta",
  "aceptacion",
  "de",
  "a",
  "da",
  "pide",
  "ciclo"
 ],
 "properties": {
  "esquema": {
   "const": "atlas.asiento/1"
  },
  "n": {
   "type": "integer",
   "minimum": 1,
   "maximum": 1000000
  },
  "prev": {
   "anyOf": [
    {
     "const": "genesis"
    },
    {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   ]
  },
  "oferta": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "aceptacion": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "de": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "a": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "da": {
   "type": "object",
   "additionalProperties": false,
   "minProperties": 1,
   "properties": {
    "luz": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "biomasa": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "cobre": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "flujo": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "oxigeno": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    }
   }
  },
  "pide": {
   "type": "object",
   "additionalProperties": false,
   "minProperties": 1,
   "properties": {
    "luz": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "biomasa": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "cobre": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "flujo": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    },
    "oxigeno": {
     "type": "integer",
     "minimum": 1,
     "maximum": 1000000
    }
   }
  },
  "ciclo": {
   "type": "integer",
   "minimum": 0,
   "maximum": 1000000000
  }
 }
}
